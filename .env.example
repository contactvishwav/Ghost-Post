# ─── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# ─── Database ──────────────────────────────────────────────────────────────────
# Local Postgres: postgresql://postgres:password@localhost:5432/ghostpost
DATABASE_URL=

# ─── Security Agent  (OpenAI) ──────────────────────────────────────────────────
# Used by: SecurityAgent (inbound/outbound scans)
# Get key: https://platform.openai.com/api-keys
SECURITY_API_KEY=
SECURITY_MODEL=gpt-4o-mini
GUARD_MODEL=gpt-4o-mini
GUARD_ENABLED=true

# ─── Drafting + Hook Agent  (Perplexity) ───────────────────────────────────────
# Used by: DraftingAgent, HookAgent — the core writing pipeline
# Get key: https://www.perplexity.ai/settings/api
DRAFTING_API_KEY=
DRAFTING_MODEL=sonar
DRAFTING_URL=https://api.perplexity.ai/chat/completions

# ─── Research Agent  (Perplexity — same key as Drafting) ───────────────────────
# Used by: ResearchAgent, Watchlist refresh
PERPLEXITY_API_KEY=

# ─── Validation Agent  (Google Gemini) ─────────────────────────────────────────
# Used by: ValidationAgent / AuditProvider
# Get key: https://aistudio.google.com/app/apikey
VALIDATION_API_KEY=
VALIDATION_MODEL=gemini-2.5-flash

# ─── Refinement Agent  (OpenAI — same key as Security) ─────────────────────────
# Used by: RefinementAgent
REFINEMENT_API_KEY=
REFINEMENT_MODEL=gpt-4o

# ─── Voice Dictation  (Deepgram) ───────────────────────────────────────────────
# Optional — voice input in Dump step silently falls back without this
# Get key: https://console.deepgram.com/
DEEPGRAM_API_KEY=

# ─── Observability  (Helicone — optional) ──────────────────────────────────────
# Keep false locally — Observability view uses Postgres AgentLog instead
HELICONE_ENABLED=false
HELICONE_API_KEY=
HELICONE_URL=http://localhost:8787/v1
