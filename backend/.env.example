# ─── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# ─── Database ──────────────────────────────────────────────────────────────────
# Local Postgres: postgresql://postgres:password@localhost:5432/ghostpost
DATABASE_URL=

# ─── Security Agent  (OpenAI) ──────────────────────────────────────────────────
# Used by: SecurityAgent (inbound/outbound scans), StandardProvider
# Get key: https://platform.openai.com/api-keys
SECURITY_API_KEY=
SECURITY_MODEL=gpt-4o-mini
GUARD_MODEL=gpt-4o-mini
GUARD_ENABLED=true

# ─── Drafting + Hook Agent  (OpenAI) ───────────────────────────────────────────
# Used by: DraftingAgent.generateDraft(), HookAgent.refineHooks()
# Same key as SECURITY_API_KEY. gpt-4o-mini is cost-efficient for writing.
DRAFTING_API_KEY=
DRAFTING_MODEL=gpt-4o-mini
DRAFTING_URL=https://api.openai.com/v1/chat/completions

# ─── Research Agent  (defaults to Drafting config above) ───────────────────────
# Used by: DraftingAgent.research(), ResearchService
# Leave blank — config inherits DRAFTING_API_KEY + DRAFTING_URL automatically.
# Uncomment and set RESEARCH_URL to use Perplexity for live web search instead.
PERPLEXITY_API_KEY=
# RESEARCH_MODEL=gpt-4o-mini
# RESEARCH_URL=https://api.perplexity.ai/chat/completions

# ─── Validation Agent  (Google Gemini) ─────────────────────────────────────────
# Used by: AuditProvider / ValidationAgent
# Get key: https://aistudio.google.com/app/apikey
VALIDATION_API_KEY=
VALIDATION_MODEL=gemini-2.5-flash

# ─── Refinement Agent  (OpenAI — same key as Security) ─────────────────────────
# Used by: RefinementProvider / RefinementAgent
REFINEMENT_API_KEY=
REFINEMENT_MODEL=gpt-4o

# ─── Voice Dictation  (Deepgram) ───────────────────────────────────────────────
# Used by: WebSocket relay for voice-to-text in DumpEditor
# Get key: https://console.deepgram.com/
# Optional — voice input will silently fail without this
DEEPGRAM_API_KEY=

# ─── Observability  (Helicone — optional) ──────────────────────────────────────
# Leave HELICONE_ENABLED=false to use Postgres AgentLog metrics locally
HELICONE_ENABLED=false
HELICONE_API_KEY=
HELICONE_URL=http://localhost:8787/v1
