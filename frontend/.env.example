# Backend API target for the Vite dev-server proxy.
# Copy this file to .env and set the value for your environment.

# Local development (default — used when VITE_BACKEND_URL is not set):
VITE_BACKEND_URL=http://localhost:5000

# Docker Compose — uncomment and replace the line above:
# VITE_BACKEND_URL=http://backend:5000
